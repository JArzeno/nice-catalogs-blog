---
import { getTerm, getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import LanguageFilter from "../../components/LanguageFilter.astro";
import PostCard from "../../components/PostCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { filterByLanguage, langFilter } from "../../utils/language";
import { getReadingTime } from "../../utils/reading-time";

const { slug } = Astro.params;
const term = slug ? await getTerm("tag", slug) : null;

const base = "/blog";
if (!term) {
	return Astro.redirect(`${base}/404`);
}

const { entries: allPosts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);

// Optional ?lang=en|es filter
const lang = langFilter(Astro.url);
const posts = filterByLanguage(allPosts, lang);

// Fetch tags and bylines for display on each post card
const filteredPosts = await Promise.all(
	posts.map(async (post) => {
		const tags = await getEntryTerms("posts", post.data.id, "tag");
		const bylines = post.data.bylines ?? [];
		return { post, tags, bylines };
	})
);
---

<Base
	title={`${term.label} Guides | Nice Catalogs`}
	description={`${filteredPosts.length} guide${filteredPosts.length === 1 ? "" : "s"} about ${term.label.toLowerCase()} for digital catalogs, QR menus, and online ordering.`}
>
	<section class="archive-section">
		<Breadcrumbs items={[{ label: term.label }]} />
		<header class="archive-header">
			<span class="archive-label">Tag</span>
			<h1 class="archive-title">{term.label}</h1>
			<p class="archive-count">
				{filteredPosts.length}
				{filteredPosts.length === 1 ? "post" : "posts"}
			</p>
			<div class="archive-filter">
				<LanguageFilter current={lang} />
			</div>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">
					{lang ? "No posts with this tag in this language yet." : "No posts with this tag yet."}
				</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags, bylines }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`${base}/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							bylines={bylines}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-12);
	}

	.archive-header {
		margin-top: var(--spacing-8);
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.archive-filter {
		margin-top: var(--spacing-6);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
