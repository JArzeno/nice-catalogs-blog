---
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import LanguageFilter from "../../components/LanguageFilter.astro";
import PostCard from "../../components/PostCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { filterByLanguage, langFilter } from "../../utils/language";
import { getReadingTime } from "../../utils/reading-time";

const { entries: allPosts, cacheHint } = await getEmDashCollection("posts");

Astro.cache.set(cacheHint);

// Optional ?lang=en|es filter
const lang = langFilter(Astro.url);
const posts = filterByLanguage(allPosts, lang);

const sortedPosts = posts.toSorted((a, b) => {
	const dateA = a.data.publishedAt?.getTime() ?? 0;
	const dateB = b.data.publishedAt?.getTime() ?? 0;
	return dateB - dateA;
});

// Fetch tags for each post (bylines are already hydrated by getEmDashCollection)
const postsWithTags = await Promise.all(
	sortedPosts.map(async (post) => {
		const tags = await getEntryTerms("posts", post.data.id, "tag");
		const bylines = post.data.bylines ?? [];
		return { post, tags, bylines };
	})
);

const base = "/blog";
---

<Base 
	title="All Guides: Catalogs, QR Menus & WhatsApp | Nice Catalogs" 
	description="Complete guides on digital catalogs, QR code menus, WhatsApp ordering and sharing products online for restaurants, cafes, salons and small businesses."
>
	<div class="posts-page">
		<Breadcrumbs items={[{ label: "All Posts" }]} />
		<header class="page-header">
			<h1 class="page-title">All Posts</h1>
			<p class="page-description">
				{posts.length}
				{posts.length === 1 ? "article" : "articles"}
			</p>
			<div class="page-filter">
				<LanguageFilter current={lang} />
			</div>
		</header>

		{
			sortedPosts.length === 0 ? (
				<p class="empty">{lang ? "No posts in this language yet." : "No posts yet."}</p>
			) : (
				<div class="posts-grid">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<PostCard
							title={post.data.title ?? "Untitled"}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`${base}/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							bylines={bylines}
						/>
					))}
				</div>
			)
		}
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-top: var(--spacing-8);
		margin-bottom: var(--spacing-12);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.page-filter {
		margin-top: var(--spacing-6);
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-3xl);
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}
	}
</style>
