---
/**
 * Reading progress bar pinned under the site header.
 *
 * Fills from 0 to 100% as the reader moves through the article, and reaches
 * 100% when the end of the article body hits the bottom of the screen
 * (comments and "Continue reading" are not counted).
 *
 * The fill and its leading dot move with `transform`, so they stay on the
 * compositor. The fill follows the scroll position with a short ease so it
 * glides instead of stepping with each mouse-wheel notch.
 */
interface Props {
	/** Selector for the article body. If several elements match, the last one marks the end. */
	target?: string;
}

const { target = ".article-content, .article-faq" } = Astro.props;
---

<div class="reading-progress" data-reading-progress data-target={target} aria-hidden="true">
	<div class="reading-progress__track"></div>
	<div class="reading-progress__bar">
		<span class="reading-progress__sheen"></span>
	</div>
	<div class="reading-progress__head">
		<span class="reading-progress__dot"></span>
	</div>
</div>

<style>
	.reading-progress {
		--rp-height: 3px;
		position: fixed;
		top: var(--nav-height);
		left: 0;
		right: 0;
		height: var(--rp-height);
		/* Below the header (z-index 100) so the Tools dropdown stays on top */
		z-index: 99;
		pointer-events: none;
		opacity: 0;
		transform: translateY(-100%);
		transition:
			opacity 350ms ease,
			transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.reading-progress.is-visible {
		opacity: 1;
		transform: none;
	}

	.reading-progress__track {
		position: absolute;
		inset: 0;
		background: var(--color-border-subtle);
		opacity: 0.7;
	}

	.reading-progress__bar {
		position: absolute;
		inset: 0;
		overflow: hidden;
		transform-origin: 0 50%;
		transform: scaleX(0);
		background: linear-gradient(90deg, var(--color-accent) 0%, #ff5a4d 100%);
		border-radius: 0 var(--rp-height) var(--rp-height) 0;
		will-change: transform;
		transition: box-shadow 500ms ease;
	}

	/* A soft highlight sweeping along the filled part */
	.reading-progress__sheen {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 35%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
		animation: rp-sheen 2.4s cubic-bezier(0.45, 0, 0.25, 1) infinite;
	}

	/* The head rides the leading edge; JS sets its translateX */
	.reading-progress__head {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0;
		height: 0;
		will-change: transform;
	}

	.reading-progress__dot {
		position: absolute;
		top: -4.5px;
		left: -4.5px;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow:
			0 0 0 2px #fff,
			0 0 12px 3px var(--color-accent-ring);
		transform: scale(0);
		transition: transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	/* The dot pops out while the reader scrolls and tucks away when they stop */
	.reading-progress.is-scrolling .reading-progress__dot {
		transform: scale(1);
		animation: rp-pulse 1.6s ease-out infinite;
	}

	/* Finished: the bar glows and the dot disappears */
	.reading-progress.is-complete .reading-progress__bar {
		box-shadow: 0 0 14px 1px var(--color-accent-ring);
		animation: rp-complete 900ms ease-out 1;
	}

	.reading-progress.is-complete .reading-progress__dot {
		transform: scale(0);
		animation: none;
	}

	@keyframes rp-sheen {
		0% {
			transform: translateX(-100%);
		}
		60%,
		100% {
			transform: translateX(300%);
		}
	}

	@keyframes rp-pulse {
		0% {
			box-shadow:
				0 0 0 2px #fff,
				0 0 0 2px var(--color-accent-ring),
				0 0 12px 3px var(--color-accent-ring);
		}
		100% {
			box-shadow:
				0 0 0 2px #fff,
				0 0 0 12px rgba(237, 28, 36, 0),
				0 0 12px 3px var(--color-accent-ring);
		}
	}

	@keyframes rp-complete {
		0% {
			filter: brightness(1);
		}
		35% {
			filter: brightness(1.3) saturate(1.2);
		}
		100% {
			filter: brightness(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reading-progress,
		.reading-progress__bar,
		.reading-progress__dot {
			transition: none;
		}

		.reading-progress__sheen,
		.reading-progress.is-scrolling .reading-progress__dot,
		.reading-progress.is-complete .reading-progress__bar {
			animation: none;
		}
	}

	@media print {
		.reading-progress {
			display: none;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>("[data-reading-progress]");
	const bar = root?.querySelector<HTMLElement>(".reading-progress__bar");
	const head = root?.querySelector<HTMLElement>(".reading-progress__head");
	const ends = root
		? document.querySelectorAll<HTMLElement>(root.dataset.target ?? ".article-content")
		: [];
	// The last match in document order is the end of the readable body
	const end = ends.length ? ends[ends.length - 1] : null;

	if (root && bar && head && end) {
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		// ~90ms time constant keeps the bar glued to the scroll position while
		// smoothing out wheel notches and anchor-link jumps.
		const SMOOTHING_MS = 90;
		const SCROLLING_IDLE_MS = 700;
		const SHOW_AFTER_PX = 4;
		const DONE_AT = 0.995;
		// Very short articles would otherwise jump from 0 to 100% in a few pixels
		const MIN_SCROLL_RANGE_PX = 240;

		let scrollMax = MIN_SCROLL_RANGE_PX; // scrollY at which the end of the article reaches the bottom of the screen
		let trackWidth = root.clientWidth;
		let goal = 0; // where the scroll position says we should be (0..1)
		let shown = 0; // where the bar is drawn right now (0..1)
		let lastFrame = 0;
		let frame = 0;
		let idleTimer = 0;

		const clamp = (n: number) => Math.min(1, Math.max(0, n));

		function measure() {
			const endBottom = end!.getBoundingClientRect().bottom + window.scrollY;
			scrollMax = Math.max(MIN_SCROLL_RANGE_PX, endBottom - window.innerHeight);
			trackWidth = root!.clientWidth;
			readScroll();
		}

		function paint() {
			bar!.style.transform = `scaleX(${shown})`;
			head!.style.transform = `translate3d(${Math.min(shown * trackWidth, trackWidth - 5)}px,0,0)`;
		}

		function tick(now: number) {
			const dt = lastFrame ? Math.min(now - lastFrame, 64) : 16;
			lastFrame = now;
			const delta = goal - shown;
			if (Math.abs(delta) < 0.0004) {
				shown = goal;
			} else {
				// Frame-rate independent exponential ease toward the goal
				shown += delta * (1 - Math.exp(-dt / SMOOTHING_MS));
			}
			paint();
			if (shown !== goal) {
				frame = requestAnimationFrame(tick);
			} else {
				frame = 0;
				lastFrame = 0;
			}
		}

		function requestPaint() {
			if (reduceMotion.matches) {
				shown = goal;
				paint();
			} else if (!frame) {
				frame = requestAnimationFrame(tick);
			}
		}

		function readScroll() {
			const y = window.scrollY;
			goal = clamp(y / scrollMax);
			root!.classList.toggle("is-visible", y > SHOW_AFTER_PX);
			root!.classList.toggle("is-complete", goal >= DONE_AT);
			requestPaint();
		}

		function onScroll() {
			readScroll();
			root!.classList.add("is-scrolling");
			window.clearTimeout(idleTimer);
			idleTimer = window.setTimeout(() => root!.classList.remove("is-scrolling"), SCROLLING_IDLE_MS);
		}

		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", measure, { passive: true });
		// Late-loading images and fonts change the page height
		new ResizeObserver(measure).observe(document.body);
		window.addEventListener("load", measure);
		// Back/forward cache restores the page with a stale layout
		window.addEventListener("pageshow", measure);

		measure();
		// Start the first paint from the real position (e.g. a reload mid-article)
		shown = goal;
		paint();
	}
</script>
